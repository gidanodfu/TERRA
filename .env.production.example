# TERRA production configuration. Copy to .env.production and replace every value.
# Never reuse development credentials or storage paths.
APP_ENV=production
APP_PUBLIC_URL=https://terra.example.org
API_INTERNAL_URL=http://api:8080

POSTGRES_DB=terra
POSTGRES_USER=terra
POSTGRES_PASSWORD=change-me-strong-database-password
DATABASE_URL=postgres://terra:change-me-strong-database-password@db:5432/terra?sslmode=disable

# openssl rand -hex 32
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=terra_session
SESSION_TTL_HOURS=12

GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URL=https://terra.example.org/api/v1/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URL=https://terra.example.org/api/v1/auth/google/drive/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# openssl rand -base64 32 — back up separately from database and documents
TOKEN_ENCRYPTION_KEY=change-me
TURNSTILE_SITE_KEY=change-me
TURNSTILE_SECRET_KEY=change-me
TURNSTILE_HOSTNAME=terra.example.org
TURNSTILE_ACTION=admin_login

# Host directory mounted into the containers. Must be owned by UID/GID 10001.
STORAGE_HOST_PATH_PROD=/srv/terra-data/prod
STORAGE_ROOT=/var/lib/terra
WEB_PORT=8080

DOWNLOAD_MIN_INTERVAL_MS=1500
WORKER_CONCURRENCY=3
WORKER_PER_ACCOUNT_CONCURRENCY=2
WORKER_LEASE_SECONDS=180
WORKER_HEARTBEAT_SECONDS=10

MAX_DOWNLOAD_BYTES=5368709120
MAX_JOB_BYTES=53687091200
MAX_USER_STORAGE_BYTES=107374182400
MAX_AREA_STORAGE_BYTES=536870912000
MAX_ACTIVE_JOBS_GLOBAL=4
MAX_ACTIVE_JOBS_PER_USER=1
MIN_FREE_DISK_BYTES=10737418240
RETENTION_DAYS=0

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-initial-password
