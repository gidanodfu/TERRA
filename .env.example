# Copy to .env and fill every value. Never commit .env.
APP_ENV=development
APP_PUBLIC_URL=http://localhost:8080
API_INTERNAL_URL=http://api:8080

POSTGRES_DB=terra
POSTGRES_USER=terra
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://terra:change-me@db:5432/terra?sslmode=disable

# openssl rand -hex 32
SESSION_SECRET=
SESSION_COOKIE_NAME=terra_session
SESSION_TTL_HOURS=12

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URIs registered in Google Cloud Console.
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/drive/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# Base64-encoded 32 random bytes: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
TURNSTILE_ACTION=admin_login
# Optional override for automated tests; leave empty in production.
TURNSTILE_VERIFY_URL=

# Host directory persisted by Docker; container path is fixed by the compose file.
STORAGE_HOST_PATH=../data/dev
# Local published port for the frontend.
WEB_PORT=8080
# Local PostgreSQL port, development only.
DB_PORT=5432
STORAGE_ROOT=/var/lib/terra

DOWNLOAD_MIN_INTERVAL_MS=1500
WORKER_CONCURRENCY=3
WORKER_PER_ACCOUNT_CONCURRENCY=2
WORKER_LEASE_SECONDS=180
WORKER_HEARTBEAT_SECONDS=10

# Administrative capacity limits (bytes / counts). Production values need approval.
MAX_DOWNLOAD_BYTES=5368709120
MAX_JOB_BYTES=53687091200
MAX_USER_STORAGE_BYTES=107374182400
MAX_AREA_STORAGE_BYTES=536870912000
MAX_ACTIVE_JOBS_GLOBAL=4
MAX_ACTIVE_JOBS_PER_USER=1
MIN_FREE_DISK_BYTES=10737418240
# 0 disables automatic snapshot retention.
RETENTION_DAYS=0

# Used only by the explicit bootstrap command; not by the API at runtime.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
