# Copia este archivo a .env y completa todos los valores. Nunca hagas commit de .env.
APP_ENV=development
APP_PUBLIC_URL=http://localhost:8080
API_INTERNAL_URL=http://api:8080

# Fuente única de credenciales internas. La API construye el DSN hacia db:5432.
POSTGRES_DB=terra
POSTGRES_USER=terra
POSTGRES_PASSWORD=change-me

# openssl rand -hex 32
SESSION_SECRET=
SESSION_COOKIE_NAME=terra_session
SESSION_TTL_HOURS=12

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir exactamente con las URI de redirección registradas en Google Cloud Console.
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/drive/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# 32 bytes aleatorios codificados en Base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=localhost
TURNSTILE_ACTION=admin_login
# Sobrescritura opcional para pruebas controladas; déjala vacía para usar el endpoint oficial.
TURNSTILE_VERIFY_URL=

# Directorio local del host persistido por Docker; Compose fija la ruta del contenedor.
STORAGE_HOST_PATH=../data/dev
# Puerto local publicado para el frontend.
WEB_PORT=8080
# Puerto local publicado de PostgreSQL (solo loopback 127.0.0.1).
DB_PORT=5432
STORAGE_ROOT=/var/lib/terra

DOWNLOAD_MIN_INTERVAL_MS=1500
WORKER_CONCURRENCY=3
WORKER_PER_ACCOUNT_CONCURRENCY=2
WORKER_LEASE_SECONDS=180
WORKER_HEARTBEAT_SECONDS=10

# Límites de capacidad del desarrollo local (bytes / recuentos).
MAX_DOWNLOAD_BYTES=5368709120
MAX_JOB_BYTES=53687091200
MAX_USER_STORAGE_BYTES=107374182400
MAX_AREA_STORAGE_BYTES=536870912000
MAX_ACTIVE_JOBS_GLOBAL=4
MAX_ACTIVE_JOBS_PER_USER=1
MIN_FREE_DISK_BYTES=1073741824
# 0 desactiva la retención automática de snapshots.
RETENTION_DAYS=0

# Se usa solo por el comando explícito de bootstrap.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
