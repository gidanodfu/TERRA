#!/usr/bin/env bash
# =============================================================================
# TERRA - ./terra
# Versión: 2.0.0
# Descripción: interfaz única de control del entorno local. Delega en los
#              scripts de deploy/scripts; no duplica lógica de operación.
# Uso: ./terra <help|check|doctor|build|init|up|down|restart|status|logs|
#               shell|db|migrate|bootstrap|test|backup|restore>
# Requisitos: Docker Engine, Docker Compose v2 y Bash.
# Efectos: depende del subcomando. Nunca elimina volúmenes automáticamente.
# Códigos: los del subcomando; 2 para uso incorrecto.
# =============================================================================
set -Eeuo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS="$ROOT/deploy/scripts"

if [[ ! -x "$SCRIPTS/help.sh" ]]; then
  printf '[TERRA] No se encontraron los scripts en %s\n' "$SCRIPTS" >&2
  exit 1
fi

command="${1:-help}"
shift || true

case "$command" in
  help|-h|--help)
    exec "$SCRIPTS/help.sh"
    ;;
  check)
    exec "$SCRIPTS/check.sh" "$@"
    ;;
  doctor)
    exec "$SCRIPTS/doctor.sh" "$@"
    ;;
  build)
    exec "$SCRIPTS/build.sh" "$@"
    ;;
  init)
    exec "$SCRIPTS/init.sh" "$@"
    ;;
  up)
    exec "$SCRIPTS/up.sh" "$@"
    ;;
  down)
    exec "$SCRIPTS/down.sh" "$@"
    ;;
  restart)
    exec "$SCRIPTS/restart.sh" "$@"
    ;;
  status)
    exec "$SCRIPTS/status.sh" "$@"
    ;;
  logs)
    exec "$SCRIPTS/logs.sh" "$@"
    ;;
  shell)
    exec "$SCRIPTS/shell.sh" "$@"
    ;;
  db)
    exec "$SCRIPTS/db.sh" "$@"
    ;;
  migrate)
    exec "$SCRIPTS/migrate.sh" "$@"
    ;;
  bootstrap)
    exec "$SCRIPTS/bootstrap.sh" "$@"
    ;;
  test)
    exec "$SCRIPTS/test.sh" "$@"
    ;;
  backup)
    exec "$SCRIPTS/backup-local.sh" "$@"
    ;;
  restore)
    exec "$SCRIPTS/restore-local.sh" "$@"
    ;;
  *)
    printf '[TERRA] Comando desconocido: %s\n\n' "$command" >&2
    "$SCRIPTS/help.sh" >&2
    exit 2
    ;;
esac
